# ExerciseDB 作为主源
EXERCISEDB_SOURCE_URL=https://your-exercisedb-endpoint.example.com/exercises
EXERCISEDB_SOURCE_API_KEY=replace-with-your-key
EXERCISEDB_SOURCE_HOST=replace-with-your-host
EXERCISEDB_SOURCE_AUTHORIZATION=
EXERCISEDB_SOURCE_MEDIA_BASE_URL=
EXERCISEDB_SOURCE_LIMIT=200

# Wger 作为补充源
WGER_SOURCE_URL=https://your-wger-endpoint.example.com/api/v2/exerciseinfo/
WGER_SOURCE_API_KEY=
WGER_SOURCE_HOST=
WGER_SOURCE_AUTHORIZATION=
WGER_SOURCE_MEDIA_BASE_URL=
WGER_SOURCE_LIMIT=200

# 媒体下载与云端同步
EXERCISE_DOWNLOAD_MEDIA=1
WECHAT_CLOUD_ENV=cloud1-xxxx
EXERCISE_CLOUD_PATH_PREFIX=exercise-media
EXERCISE_MEDIA_BASE_URL=https://your-cdn-domain.example.com
