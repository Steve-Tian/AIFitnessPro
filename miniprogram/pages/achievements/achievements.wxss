/* miniprogram/pages/achievements/achievements.wxss */
.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.stats-card {
  background: white;
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
  display: flex;
  justify-content: space-around;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}

.stat-item {
  text-align: center;
}

.stat-number {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #667eea;
  margin-bottom: 10rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #666;
}

.stat-divider {
  width: 2rpx;
  height: 80rpx;
  background: #eee;
  margin: auto 0;
}

.achievements-list {
  margin-bottom: 30rpx;
}

.achievement-card {
  background: white;
  border-radius: 15rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.03);
}

.achievement-card.unlocked {
  border-left: 8rpx solid #4CAF50;
  background: linear-gradient(90deg, #f8fff8, #ffffff);
}

.achievement-card.locked {
  border-left: 8rpx solid #9E9E9E;
  opacity: 0.7;
}

.achievement-icon {
  font-size: 48rpx;
  margin-right: 25rpx;
  width: 60rpx;
  text-align: center;
}

.achievement-content {
  flex: 1;
}

.achievement-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.achievement-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.achievement-points {
  font-size: 24rpx;
  color: #FF9800;
  background: #fff3e0;
  padding: 5rpx 15rpx;
  border-radius: 20rpx;
}

.achievement-description {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
}

.achievement-status {
  margin-left: 20rpx;
}

.status-text {
  font-size: 24rpx;
  color: #999;
}

.check-button-container {
  text-align: center;
  padding: 30rpx 0;
}

.check-button {
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: white;
  border: none;
  border-radius: 50rpx;
  padding: 25rpx 60rpx;
  font-size: 32rpx;
  box-shadow: 0 4rpx 15rpx rgba(102, 126, 234, 0.3);
}

.loading {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}