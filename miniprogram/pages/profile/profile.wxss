.page {
  min-height: 100vh;
  background-color: #f5f6fa;
  background-color: var(--color-bg);
}

.container {
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40rpx;
}

.avatar {
  width: 144rpx;
  height: 144rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, var(--color-primary), var(--color-primary-dark));
  box-shadow: var(--shadow-md);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-text {
  font-size: 56rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1;
}

.avatar-emoji {
  font-size: 64rpx;
  line-height: 1;
}

.hero-hint {
  margin-top: 16rpx;
  font-size: var(--font-sm);
}

.card {
  background: var(--color-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
}

/* 统计卡片 */
.stats-card {
  padding: 32rpx 16rpx;
  margin-bottom: 24rpx;
}

.stats-grid {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-around;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-primary);
  line-height: 1.2;
}

.stat-label {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  margin-top: 8rpx;
}

.stat-divider {
  width: 1rpx;
  height: 64rpx;
  background: var(--color-divider);
}

.info-card {
  padding: 32rpx;
  margin-bottom: 40rpx;
}

.info-card.muted {
  padding: 32rpx;
}

.info-title {
  display: block;
  font-size: var(--font-md);
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: 24rpx;
}

.info-row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--color-divider);
}

.info-row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.info-label {
  font-size: var(--font-base);
  flex-shrink: 0;
  margin-right: 24rpx;
}

.info-value {
  font-size: var(--font-base);
  color: var(--color-text);
  text-align: right;
  flex: 1;
}

.empty-hint {
  font-size: var(--font-sm);
  line-height: 1.6;
}

.section-label {
  display: block;
  font-size: var(--font-sm);
  font-weight: 600;
  color: var(--color-text-secondary);
  margin-bottom: 16rpx;
  padding-left: 8rpx;
}

.settings-card {
  padding: 0 8rpx;
  overflow: hidden;
  margin-bottom: 32rpx;
}

.settings-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 24rpx;
}

.settings-left {
  flex: 1;
}

.settings-name {
  font-size: var(--font-base);
  color: var(--color-text);
}

.settings-desc {
  display: block;
  font-size: 22rpx;
  color: var(--color-text-secondary);
  margin-top: 4rpx;
}

.settings-right {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex-shrink: 0;
}

.settings-value {
  font-size: var(--font-sm);
  margin-right: 8rpx;
}

.settings-chevron {
  font-size: 36rpx;
  line-height: 1;
}

.settings-divider {
  height: 1rpx;
  background: var(--color-divider);
  margin-left: 24rpx;
}

/* 选择器弹窗 */
.picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.picker-panel {
  width: 100%;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 32rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.picker-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--color-text);
  text-align: center;
  margin-bottom: 32rpx;
}

.picker-options {
  margin-bottom: 24rpx;
}

.picker-option {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 28rpx 24rpx;
  border-radius: 16rpx;
  background: #f8f8fc;
  margin-bottom: 16rpx;
  position: relative;
}

.picker-option-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
  flex: 1;
}

.picker-option-desc {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-left: 16rpx;
  flex-shrink: 0;
}

.picker-option-check {
  margin-left: 16rpx;
  flex-shrink: 0;
}

.check-icon {
  font-size: 28rpx;
  color: var(--color-primary);
  font-weight: 700;
}

.picker-cancel {
  display: block;
  text-align: center;
  font-size: 30rpx;
  color: var(--color-text-secondary);
  padding: 24rpx 0;
}
