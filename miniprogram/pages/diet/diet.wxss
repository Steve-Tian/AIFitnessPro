.page {
  min-height: 100vh;
  background-color: #f5f6fa;
  background-color: var(--color-bg);
}

.container {
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.target-row {
  background: var(--color-card);
  border-radius: var(--radius-lg);
  padding: 28rpx 32rpx;
  box-shadow: var(--shadow-sm);
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.target-value {
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--color-text);
}

.target-hint {
  font-size: var(--font-sm);
}

.dash {
  color: var(--color-text-hint);
  font-weight: 500;
}

.macros {
  background: var(--color-card);
  border-radius: var(--radius-lg);
  padding: 28rpx 32rpx;
  box-shadow: var(--shadow-sm);
  margin-bottom: 24rpx;
}

.macros-title {
  display: block;
  font-size: var(--font-sm);
  font-weight: 600;
  color: var(--color-text-secondary);
  margin-bottom: 20rpx;
}

.macro-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 24rpx;
}

.macro-row:last-child {
  margin-bottom: 0;
}

.macro-name {
  width: 100rpx;
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  flex-shrink: 0;
}

.macro-bar-wrap {
  flex: 1;
  height: 16rpx;
  background: var(--color-divider);
  border-radius: var(--radius-full);
  overflow: hidden;
  margin: 0 20rpx;
}

.macro-bar {
  height: 100%;
  border-radius: var(--radius-full);
  min-width: 0;
}

.macro-bar--protein {
  background: linear-gradient(90deg, var(--color-primary), var(--color-primary-light));
}

.macro-bar--carb {
  background: linear-gradient(90deg, #4a90ff, #74b9ff);
}

.macro-bar--fat {
  background: linear-gradient(90deg, #fdcb6e, #f39c12);
}

.macro-pct {
  width: 56rpx;
  font-size: var(--font-xs);
  text-align: right;
  flex-shrink: 0;
}

.card {
  background: var(--color-card);
  border-radius: var(--radius-lg);
  padding: 40rpx 32rpx;
  box-shadow: var(--shadow-sm);
  border-left: 6rpx solid var(--color-success);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.card-emoji {
  font-size: 48rpx;
  line-height: 1;
}

.placeholder {
  font-size: var(--font-base);
  line-height: 1.6;
  text-align: center;
}
