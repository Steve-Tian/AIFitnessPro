.onboarding {
  min-height: 100vh;
  background: linear-gradient(180deg, #F8F7FF 0%, #F5F6FA 100%);
  display: flex;
  flex-direction: column;
  padding-top: 88rpx;
}

/* 顶部进度 */
.header {
  padding: 32rpx 48rpx 0;
}

.progress-bar {
  width: 100%;
  height: 8rpx;
  background: #EEEEF5;
  border-radius: 4rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(135deg, #6C5CE7, #4A90FF);
  border-radius: 4rpx;
  transition: width 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

.step-counter {
  display: block;
  text-align: right;
  font-size: 24rpx;
  color: #B2BEC3;
  margin-top: 12rpx;
}

/* 问题区域 */
.question-area {
  flex: 1;
  padding: 48rpx 48rpx 0;
  overflow-y: auto;
}

.step {
  animation: slideIn 0.3s ease;
}

@keyframes slideIn {
  from {
    opacity: 0;
    transform: translateX(60rpx);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

.q-title {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: #1A1A2E;
  line-height: 1.3;
  margin-bottom: 12rpx;
}

.q-desc {
  display: block;
  font-size: 28rpx;
  color: #636E72;
  margin-bottom: 56rpx;
}

/* 数字滑块 */
.number-display {
  display: flex;
  align-items: baseline;
  justify-content: center;
  margin-bottom: 48rpx;
}

.number-value {
  font-size: 120rpx;
  font-weight: 800;
  color: #6C5CE7;
  line-height: 1;
}

.number-unit {
  font-size: 36rpx;
  color: #636E72;
  margin-left: 12rpx;
  font-weight: 500;
}

.custom-slider {
  margin: 0 16rpx;
}

.slider-labels {
  display: flex;
  justify-content: space-between;
  padding: 8rpx 16rpx 0;
  font-size: 22rpx;
  color: #B2BEC3;
}

/* 选项网格 */
.options-grid {
  display: grid;
  gap: 24rpx;
}

.options-grid.cols-2 {
  grid-template-columns: 1fr 1fr;
}

.options-grid.cols-3 {
  grid-template-columns: 1fr 1fr 1fr;
}

/* 选项列表 */
.options-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* 选项卡片 - 竖排（性别、训练天数） */
.option-card {
  background: #FFFFFF;
  border: 3rpx solid #EEEEF5;
  border-radius: 24rpx;
  padding: 36rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
}

.option-card.selected {
  border-color: #6C5CE7;
  background: #F8F7FF;
  box-shadow: 0 4rpx 20rpx rgba(108, 92, 231, 0.15);
}

.option-card:active {
  transform: scale(0.97);
}

/* 选项卡片 - 横排（目标、经验、器械、搭子） */
.option-card.horizontal {
  flex-direction: row;
  align-items: center;
  padding: 28rpx 32rpx;
  gap: 24rpx;
}

.option-emoji {
  font-size: 48rpx;
  line-height: 1;
}

.option-label {
  font-size: 30rpx;
  font-weight: 600;
  color: #2D3436;
}

.option-hint {
  font-size: 22rpx;
  color: #B2BEC3;
  margin-top: 2rpx;
}

.option-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

/* 多选复选框 */
.checkbox {
  width: 44rpx;
  height: 44rpx;
  border: 3rpx solid #DADAE5;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: all 0.2s ease;
}

.checkbox.checked {
  background: #6C5CE7;
  border-color: #6C5CE7;
}

.checkbox text {
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 700;
}

/* 搭子人格头像 */
.persona-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.persona-icon {
  font-size: 44rpx;
}

.coach-bg {
  background: linear-gradient(135deg, #FF6348, #FF9F43);
}

.bro-bg {
  background: linear-gradient(135deg, #26DE81, #20BF6B);
}

.roast-bg {
  background: linear-gradient(135deg, #6C5CE7, #A29BFE);
}

.beauty-coach-bg {
  background: linear-gradient(135deg, #FF7EB3, #FF758C);
}

.option-card.persona.selected .persona-avatar {
  box-shadow: 0 4rpx 16rpx rgba(108, 92, 231, 0.3);
}

/* 底部导航 */
.nav-area {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 24rpx 48rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  gap: 24rpx;
}

.btn-back {
  background: transparent;
  color: #636E72;
  font-size: 28rpx;
  border: none;
  padding: 24rpx 32rpx;
  flex-shrink: 0;
}

.btn-back::after {
  border: none;
}

.btn-placeholder {
  width: 120rpx;
}

.btn-next {
  flex: 1;
  background: linear-gradient(135deg, #6C5CE7, #4A90FF);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  border-radius: 999rpx;
  padding: 28rpx 0;
  text-align: center;
  transition: opacity 0.2s ease;
}

.btn-next::after {
  border: none;
}

.btn-next.disabled,
.btn-next[disabled] {
  opacity: 0.35;
  background: linear-gradient(135deg, #6C5CE7, #4A90FF);
  color: #FFFFFF;
}

/* Loading 覆盖层 */
.loading-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.95);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.loading-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 32rpx;
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid #EEEEF5;
  border-top: 6rpx solid #6C5CE7;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 30rpx;
  color: #636E72;
  font-weight: 500;
}
