/* miniprogram/pages/static/static.wxss */
.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.user-card {
  background: linear-gradient(135deg, #667eea, #764ba2);
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
  color: white;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
}

.username {
  font-size: 36rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 20rpx;
}

.streak {
  display: flex;
  align-items: center;
}

.streak-num {
  font-size: 60rpx;
  font-weight: bold;
  margin-right: 15rpx;
}

.streak-label {
  font-size: 24rpx;
  opacity: 0.9;
}

.plan-section {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.plan-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(300rpx, 1fr));
  gap: 20rpx;
}

.day-card {
  border: 2rpx solid #e0e0e0;
  border-radius: 15rpx;
  padding: 25rpx;
  position: relative;
}

.day-card.push {
  border-left: 8rpx solid #ff6b6b;
}

.day-card.pull {
  border-left: 8rpx solid #4ecdc4;
}

.day-card.legs {
  border-left: 8rpx solid #45b7d1;
}

.day-card.rest-day {
  border-left: 8rpx solid #95a5a6;
  background-color: #f8f9fa;
}

.day-date {
  font-size: 24rpx;
  color: #666;
  display: block;
  margin-bottom: 10rpx;
}

.day-type {
  font-size: 32rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 20rpx;
}

.workout-list {
  margin-top: 15rpx;
}

.exercise-item {
  padding: 15rpx 0;
  border-bottom: 1rpx solid #eee;
}

.exercise-item:last-child {
  border-bottom: none;
}

.exercise-name {
  font-size: 28rpx;
  font-weight: 500;
  display: block;
  margin-bottom: 8rpx;
}

.exercise-meta {
  font-size: 24rpx;
  color: #888;
}

.rest-note {
  font-style: italic;
  color: #666;
  text-align: center;
  padding: 40rpx 0;
}