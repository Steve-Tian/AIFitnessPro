<view class="container">
  <!-- 用户信息区 -->
  <view class="user-card">
    <text class="username">欢迎回来，健身伙伴！</text>
    <view class="streak">
      <text class="streak-num">3</text>
      <text class="streak-label">连续打卡天数</text>
    </view>
  </view>

  <!-- 计划展示区 -->
  <view class="plan-section">
    <view class="section-header">
      <text class="section-title">本周训练计划</text>
    </view>

    <!-- 计划详情 -->
    <view class="plan-grid">
      <view 
        class="day-card {{day.type === 'rest' ? 'rest-day' : day.type}}" 
        wx:for="{{planData}}" 
        wx:key="index"
      >
        <text class="day-date">{{day.date}}</text>
        <text class="day-type">{{day.title}}</text>
        <view class="workout-list" wx:if="{{day.workout && day.workout.length > 0}}">
          <view class="exercise-item" wx:for="{{day.workout}}" wx:key="name">
            <text class="exercise-name">{{item.name}}</text>
            <text class="exercise-meta">{{item.sets}}组 × {{item.reps}}次 | 休息{{item.rest}}秒</text>
          </view>
        </view>
        <text class="rest-note" wx:else>{{day.note}}</text>
      </view>
    </view>
  </view>
</view>