.container {
  min-height: 100vh;
  background: #f0f2f5;
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.container.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.empty-text {
  font-size: 32rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.hero {
  background: linear-gradient(135deg, #667eea, #764ba2);
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
  color: #fff;
  text-align: center;
  margin-bottom: 32rpx;
}

.hero-title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.hero-date {
  display: block;
  font-size: 26rpx;
  opacity: 0.85;
}

.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.stat-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}

.stat-card.wide {
  margin-bottom: 20rpx;
}

.stat-value {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #333;
}

.stat-label {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.streak-banner {
  background: linear-gradient(135deg, #fceabb, #f8b500);
  border-radius: 20rpx;
  padding: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

/* 进步亮点 */
.highlight-banner {
  background: linear-gradient(135deg, #e8f5e9, #c8e6c9);
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  border-left: 6rpx solid #43a047;
}

.highlight-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #2e7d32;
  margin-bottom: 16rpx;
}

.highlight-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 8rpx 0;
}

.highlight-icon {
  font-size: 30rpx;
}

.highlight-text {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.streak-num {
  font-size: 48rpx;
  font-weight: 700;
  color: #333;
}

.streak-text {
  font-size: 28rpx;
  color: #555;
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.exercise-list {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}

.exercise-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.exercise-row:last-child {
  border-bottom: none;
}

.exercise-name {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.exercise-meta {
  font-size: 24rpx;
  color: #999;
  margin-right: 16rpx;
}

.exercise-rpe {
  font-size: 22rpx;
  color: #667eea;
  background: rgba(102, 126, 234, 0.1);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.achievement-banner {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
  border-left: 6rpx solid #667eea;
}

.achievement-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.achievement-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 8rpx 0;
}

.achievement-icon {
  font-size: 36rpx;
}

.achievement-name {
  font-size: 28rpx;
  color: #555;
}

.share-actions {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.btn-share {
  flex: 1;
  margin: 0;
  padding: 22rpx 0;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 50rpx;
  line-height: 1.3;
}

.btn-share::after {
  border: none;
}

.btn-share-wechat {
  background: linear-gradient(135deg, #07c160, #06ad56);
  color: #fff;
}

.btn-share-save {
  background: #fff;
  color: #333;
  border: 2rpx solid #e0e0e0;
}

.share-poster-canvas {
  position: fixed;
  left: -3000px;
  top: 0;
  width: 375px;
  height: 480px;
}

.actions {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}

.btn-primary {
  flex: 1;
  background: #667eea;
  color: #fff;
  border: none;
  border-radius: 50rpx;
  padding: 24rpx 0;
  font-size: 30rpx;
  font-weight: 600;
}

.btn-secondary {
  flex: 1;
  background: #fff;
  color: #667eea;
  border: 2rpx solid #667eea;
  border-radius: 50rpx;
  padding: 24rpx 0;
  font-size: 30rpx;
  font-weight: 600;
}

.achievement-more {
  margin-top: 16rpx;
  text-align: center;
  font-size: 26rpx;
  color: #667eea;
}
