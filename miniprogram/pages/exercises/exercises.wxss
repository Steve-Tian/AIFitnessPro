.page {
  min-height: 100vh;
  background-color: #f5f6fa;
  background-color: var(--color-bg);
}

.container {
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.page-header {
  display: block;
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: 24rpx;
}

.search-placeholder {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx 28rpx;
  background: var(--color-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  margin-bottom: 24rpx;
  border: 2rpx solid var(--color-border);
}

.search-icon {
  font-size: 32rpx;
  line-height: 1;
}

.search-hint {
  font-size: var(--font-sm);
}

.card.notice {
  background: var(--color-card);
  border-radius: var(--radius-lg);
  padding: 28rpx 32rpx;
  box-shadow: var(--shadow-sm);
  margin-bottom: 32rpx;
}

.notice-text {
  font-size: var(--font-base);
  line-height: 1.5;
  text-align: center;
  display: block;
}

.grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 24rpx;
}

.grid-item {
  width: calc((100% - 48rpx) / 3);
  background: var(--color-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  padding: 36rpx 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 120rpx;
  border: 2rpx solid transparent;
  box-sizing: border-box;
}

.grid-item:active {
  border-color: var(--color-primary-light);
}

.grid-label {
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--color-text);
}
