.page {
  min-height: 100vh;
  background-color: #f5f6fa;
  background-color: var(--color-bg);
}

.container {
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.page-header {
  display: block;
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: 12rpx;
}

.page-subtitle {
  display: block;
  font-size: var(--font-sm);
  line-height: 1.6;
  color: var(--color-text-secondary, #667085);
  margin-bottom: 24rpx;
}

.search-box {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx 28rpx;
  background: var(--color-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  margin-bottom: 24rpx;
  border: 2rpx solid var(--color-border);
}

.search-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: rgba(108,92,231,0.12);
  color: #6c5ce7;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 48rpx;
  text-align: center;
}

.search-input {
  flex: 1;
  font-size: var(--font-sm);
  color: var(--color-text);
}

.category-strip {
  white-space: nowrap;
  margin-bottom: 24rpx;
}

.category-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 28rpx;
  border-radius: 999rpx;
  background: #fff;
  color: #667085;
  font-size: var(--font-sm);
  margin-right: 16rpx;
  box-shadow: var(--shadow-sm);
  border: 2rpx solid transparent;
}

.category-pill.active {
  color: #fff;
  background: linear-gradient(135deg, #6c5ce7 0%, #4f46e5 100%);
}

.summary-card {
  background: linear-gradient(135deg, #111827 0%, #374151 100%);
  border-radius: 28rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
}

.summary-number {
  display: block;
  font-size: 56rpx;
  line-height: 1;
  font-weight: 700;
  color: #fff;
  margin-bottom: 10rpx;
}

.summary-label {
  display: block;
  font-size: var(--font-sm);
  color: rgba(255,255,255,0.8);
}

.exercise-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.exercise-card {
  background: var(--color-card);
  border-radius: 28rpx;
  box-shadow: var(--shadow-sm);
  overflow: hidden;
  border: 2rpx solid rgba(108,92,231,0.08);
}

.exercise-cover {
  width: 100%;
  height: 240rpx;
  background: linear-gradient(180deg, #eef2ff 0%, #f8fafc 100%);
}

.exercise-content {
  padding: 28rpx;
}

.exercise-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.exercise-name {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: 8rpx;
}

.exercise-en {
  display: block;
  font-size: var(--font-sm);
  color: var(--color-text-secondary, #667085);
}

.difficulty-badge {
  flex-shrink: 0;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(79,70,229,0.12);
  color: #4f46e5;
  font-size: 22rpx;
}

.exercise-target {
  display: block;
  font-size: var(--font-base);
  line-height: 1.7;
  color: var(--color-text);
  margin-bottom: 18rpx;
}

.meta-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 18rpx;
}

.meta-pill {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #f5f7fb;
  color: #475467;
  font-size: 22rpx;
}

.footer-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.media-status {
  font-size: 24rpx;
  color: #667085;
}

.detail-link {
  font-size: 24rpx;
  font-weight: 600;
  color: #4f46e5;
}

.empty-state {
  padding: 80rpx 32rpx;
  text-align: center;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: var(--shadow-sm);
}

.empty-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: 16rpx;
}

.empty-desc {
  display: block;
  font-size: var(--font-sm);
  line-height: 1.7;
  color: var(--color-text-secondary, #667085);
}
