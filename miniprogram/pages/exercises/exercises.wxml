<view class="page">
  <view class="container">
    <text class="page-header">动作库</text>
    <text class="page-subtitle">优先读取你自己的动作数据库；列表看封面，详情直接看 GIF / 视频示范</text>

    <view class="search-box">
      <text class="search-icon">搜</text>
      <input
        class="search-input"
        placeholder="搜索动作名称 / 肌群 / 器械"
        value="{{keyword}}"
        bindinput="handleKeywordInput"
        confirm-type="search"
      />
    </view>

    <scroll-view class="category-strip" scroll-x enable-flex show-scrollbar="{{false}}">
      <view
        class="category-pill {{selectedCategory === item.id ? 'active' : ''}}"
        wx:for="{{categories}}"
        wx:key="id"
        data-category="{{item.id}}"
        bindtap="selectCategory"
      >
        {{item.label}}
      </view>
    </scroll-view>

    <view class="summary-card">
      <text class="summary-number">{{exercises.length}}</text>
      <text class="summary-label">{{isLoading ? '正在刷新动作内容' : '当前可浏览动作'}}</text>
      <text class="summary-label">当前来源：{{librarySourceLabel}}</text>
    </view>

    <view class="exercise-list" wx:if="{{exercises.length}}">
      <view class="exercise-card" wx:for="{{exercises}}" wx:key="exercise_id" data-id="{{item.exercise_id}}" data-name="{{item.name_cn}}" bindtap="openExerciseDetail">
        <image class="exercise-cover" src="{{item.coverUrl}}" mode="aspectFill" />
        <view class="exercise-content">
          <view class="exercise-head">
            <view>
              <text class="exercise-name">{{item.name_cn}}</text>
              <text class="exercise-en">{{item.name_en}}</text>
            </view>
            <text class="difficulty-badge">{{item.difficultyLabel}}</text>
          </view>

          <text class="exercise-target">{{item.targetSummary}}</text>

          <view class="meta-row">
            <text class="meta-pill">{{item.categoryLabel}}</text>
            <text class="meta-pill">{{item.equipmentText}}</text>
          </view>

          <view class="footer-row">
            <text class="media-status">{{item.mediaStatus}}</text>
            <text class="detail-link">{{item.hasVideo ? '看视频' : (item.hasGif ? '看 GIF' : '看详情')}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="empty-state" wx:else>
      <text class="empty-title">没有找到匹配动作</text>
      <text class="empty-desc">换个关键词，或者切回全部分类看看</text>
    </view>
  </view>
</view>
