.container {
  padding: 30rpx;
  min-height: 100vh;
  background-color: #f5f5f5;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 30rpx;
  text-align: center;
  color: #333;
}

.description {
  background: white;
  padding: 20rpx;
  border-radius: 10rpx;
  margin-bottom: 30rpx;
}

.desc-text {
  font-size: 28rpx;
  line-height: 1.6;
  color: #666;
}

.create-btn {
  background: #4CAF50;
  color: white;
  border: none;
  border-radius: 10rpx;
  padding: 25rpx;
  font-size: 32rpx;
  margin-bottom: 30rpx;
  width: 100%;
}

.create-btn[disabled] {
  background: #ccc;
}

.instructions {
  background: white;
  padding: 20rpx;
  border-radius: 10rpx;
}

.inst-title {
  font-size: 32rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 15rpx;
  color: #333;
}

.inst-text {
  font-size: 26rpx;
  display: block;
  margin-bottom: 10rpx;
  color: #666;
  line-height: 1.5;
}