/* miniprogram/pages/training/training.wxss */
.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #f0f2f5;
}

.header {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  background: white;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
  z-index: 10;
}

.back-btn {
  background: none;
  border: none;
  font-size: 32rpx;
  padding: 0;
  margin: 0;
}

.title {
  flex: 1;
  text-align: center;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.spacer {
  width: 80rpx; /* 占位符，保证标题居中 */
}

.state-card {
  margin: 30rpx;
  padding: 40rpx 32rpx;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.05);
}

.state-card.error {
  border: 2rpx solid rgba(239, 68, 68, 0.16);
}

.state-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #111827;
  margin-bottom: 16rpx;
}

.state-desc {
  display: block;
  font-size: 28rpx;
  line-height: 1.7;
  color: #667085;
}

.training-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 30rpx;
  overflow-y: auto;
  box-sizing: border-box;
}

.support-card {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}

.support-item {
  padding: 20rpx 0;
  border-top: 1rpx solid #eef2f7;
}

.support-item:first-child {
  padding-top: 0;
  border-top: none;
}

.support-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 10rpx;
}

.support-name {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
}

.support-duration {
  font-size: 22rpx;
  color: #4f46e5;
  background: rgba(102,126,234,0.12);
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
}

.support-focus {
  display: block;
  font-size: 24rpx;
  color: #667085;
  margin-bottom: 12rpx;
}

.support-step {
  display: flex;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.support-badge {
  min-width: 96rpx;
  font-size: 22rpx;
  color: #4f46e5;
  background: rgba(102,126,234,0.12);
  border-radius: 999rpx;
  text-align: center;
  padding: 8rpx 0;
  align-self: flex-start;
}

.support-text {
  flex: 1;
  font-size: 26rpx;
  color: #344054;
  line-height: 1.6;
}

.exercise-info {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}

.exercise-name {
  font-size: 40rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 15rpx;
  color: #333;
}

.exercise-alias {
  font-size: 28rpx;
  color: #666;
  display: block;
  margin-bottom: 12rpx;
}

.exercise-summary {
  font-size: 26rpx;
  color: #667eea;
  display: block;
  margin-bottom: 25rpx;
}

.adaptive-banner {
  margin-bottom: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, rgba(79,70,229,0.08) 0%, rgba(6,182,212,0.08) 100%);
  border: 1rpx solid rgba(79,70,229,0.08);
}

.adaptive-title {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: #4f46e5;
  margin-bottom: 8rpx;
}

.adaptive-text {
  display: block;
  font-size: 25rpx;
  line-height: 1.6;
  color: #334155;
}

.adaptive-notes {
  margin-bottom: 24rpx;
}

.adaptive-note {
  padding: 18rpx 0;
  border-top: 1rpx solid #eef2f7;
}

.adaptive-note:first-child {
  padding-top: 0;
  border-top: none;
}

.adaptive-note-name {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 8rpx;
}

.adaptive-note-text {
  display: block;
  font-size: 24rpx;
  line-height: 1.6;
  color: #475467;
}

.set-progress {
  margin-top: 20rpx;
}

.set-text {
  font-size: 28rpx;
  color: #666;
  display: block;
  margin-bottom: 15rpx;
}

.timer-area {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #667eea, #764ba2);
  border-radius: 20rpx;
  color: white;
  margin: 20rpx 0;
}

.timer-text {
  font-size: 48rpx;
  font-weight: bold;
  margin-bottom: 30rpx;
}

.timer-number {
  font-size: 120rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.timer-label {
  font-size: 32rpx;
  opacity: 0.9;
}

.timer-skip-btn {
  margin-top: 28rpx;
  min-width: 240rpx;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 999rpx;
  background: rgba(255,255,255,0.18);
  color: #fff;
  border: 2rpx solid rgba(255,255,255,0.24);
  font-size: 28rpx;
}

.timer-skip-exercise-btn {
  margin-top: 16rpx;
  background: rgba(255,255,255,0.08);
  border: 2rpx solid rgba(255,255,255,0.16);
  font-size: 26rpx;
}

.timer-skip-row {
  display: flex;
  gap: 18rpx;
  margin-top: 28rpx;
}

.timer-quick-btn {
  min-width: 180rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 999rpx;
  background: rgba(255,255,255,0.14);
  color: #fff;
  border: 2rpx solid rgba(255,255,255,0.18);
  font-size: 26rpx;
}

.media-area {
  display: flex;
  flex-direction: column;
  margin: 20rpx 0;
  gap: 24rpx;
}

.visual-card,
.muscle-card,
.instructions {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.section-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.section-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.section-tag {
  font-size: 22rpx;
  color: #4f46e5;
  background: rgba(102,126,234,0.12);
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
}

.detail-jump {
  font-size: 22rpx;
  color: #fff;
  background: linear-gradient(135deg, #6c5ce7 0%, #4f46e5 100%);
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
}

.exercise-gif {
  width: 100%;
  height: 320rpx;
  border-radius: 15rpx;
  background: linear-gradient(180deg, #eef2ff 0%, #f8fafc 100%);
}

.motion-diagram {
  border-radius: 18rpx;
  background: linear-gradient(160deg, #f8fafc 0%, #eef2ff 100%);
  border: 1rpx solid rgba(102,126,234,0.12);
  padding: 24rpx;
}

.diagram-hero {
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid rgba(102,126,234,0.12);
}

.diagram-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #1f2937;
  display: block;
  margin-bottom: 10rpx;
}

.diagram-subtitle {
  font-size: 26rpx;
  color: #475467;
  display: block;
  line-height: 1.6;
}

.diagram-columns {
  display: flex;
  gap: 20rpx;
  margin-top: 22rpx;
}

.diagram-column {
  flex: 1;
  background: rgba(255,255,255,0.82);
  border-radius: 16rpx;
  padding: 20rpx;
}

.diagram-column-title {
  font-size: 24rpx;
  color: #475467;
  display: block;
  margin-bottom: 14rpx;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.muscle-chip {
  font-size: 24rpx;
  line-height: 1.4;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
}

.muscle-chip.primary {
  background: rgba(239,68,68,0.12);
  color: #b42318;
}

.muscle-chip.secondary {
  background: rgba(59,130,246,0.12);
  color: #175cd3;
}

.fallback-note {
  font-size: 24rpx;
  color: #667085;
  display: block;
  line-height: 1.6;
}

.diagram-flow {
  margin-top: 22rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.flow-step {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  background: rgba(255,255,255,0.85);
  border-radius: 16rpx;
  padding: 18rpx 20rpx;
}

.flow-badge {
  min-width: 96rpx;
  font-size: 22rpx;
  color: #4f46e5;
  background: rgba(102,126,234,0.12);
  border-radius: 999rpx;
  text-align: center;
  padding: 8rpx 0;
}

.flow-text {
  flex: 1;
  font-size: 26rpx;
  color: #344054;
  line-height: 1.6;
}

.instructions {
  margin-top: 0;
}

.subtitle {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 20rpx;
}

.muscle-group {
  margin-bottom: 18rpx;
}

.muscle-group-label {
  font-size: 24rpx;
  color: #475467;
  display: block;
  margin-bottom: 12rpx;
}

.muscle-summary {
  font-size: 26rpx;
  color: #344054;
  display: block;
  line-height: 1.6;
}

.fact-grid {
  display: flex;
  gap: 18rpx;
  margin-top: 24rpx;
}

.fact-card {
  flex: 1;
  background: #f8fafc;
  border-radius: 16rpx;
  padding: 20rpx;
}

.fact-label {
  font-size: 22rpx;
  color: #667085;
  display: block;
  margin-bottom: 10rpx;
}

.fact-value {
  font-size: 26rpx;
  color: #1f2937;
  display: block;
  line-height: 1.5;
}

.instruction-card {
  display: flex;
  gap: 16rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  background: #f8fafc;
  margin-bottom: 14rpx;
}

.instruction-badge {
  min-width: 96rpx;
  font-size: 22rpx;
  color: #4f46e5;
  background: rgba(102,126,234,0.12);
  border-radius: 999rpx;
  text-align: center;
  padding: 8rpx 0;
  align-self: flex-start;
}

.instruction-body {
  flex: 1;
  font-size: 28rpx;
  color: #344054;
  line-height: 1.7;
}

.tips {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.tips-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 16rpx;
}

.tip {
  font-size: 26rpx;
  color: #667085;
  display: block;
  line-height: 1.6;
}

.tip-card,
.mistake-card {
  background: #f8fafc;
  border-radius: 16rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 12rpx;
}

.mistakes {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.controls {
  display: flex;
  justify-content: space-between;
  padding: 30rpx 0 10rpx;
}

.control-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 50rpx;
  font-size: 32rpx;
  margin: 0 15rpx;
}

.start-btn {
  background: #667eea;
  color: white;
}

.skip-btn {
  background: #f0f0f0;
  color: #666;
}

.disabled-btn {
  background: #ccc;
  color: #999;
}

.confirm-btn {
  background: #667eea;
  color: white;
  border-radius: 50rpx;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 32rpx;
  margin-top: 30rpx;
}

/* RPE 评分弹窗 */
.rpe-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
}

.modal-content {
  position: relative;
  background: white;
  border-radius: 25rpx;
  padding: 50rpx;
  margin: 50rpx;
  width: 80%;
  max-width: 600rpx;
  text-align: center;
}

.modal-title {
  font-size: 36rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 15rpx;
}

.modal-desc {
  font-size: 28rpx;
  color: #666;
  display: block;
  margin-bottom: 40rpx;
}

.rpe-grid {
  display: flex;
  justify-content: center;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.rpe-btn {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  border: 2rpx solid #ddd;
  background: white;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.rpe-btn.active {
  background: #667eea;
  color: white;
  border-color: #667eea;
}

.rpe-legend {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-bottom: 30rpx;
}

/* 鼓励话语条 */
.encouragement-bar {
  margin: 0 0 20rpx;
  padding: 0;
  max-height: 0;
  overflow: hidden;
  opacity: 0;
  transition: max-height 0.3s ease, opacity 0.3s ease, padding 0.3s ease;
}

.encouragement-bar.visible {
  max-height: 120rpx;
  padding: 20rpx 24rpx;
  opacity: 1;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 18rpx;
}

.encouragement-text {
  display: block;
  font-size: 28rpx;
  color: #fff;
  text-align: center;
  font-weight: 600;
  line-height: 1.5;
}

/* 口诀横幅 */
.motto-banner {
  margin: 12rpx 0 20rpx;
  padding: 20rpx 24rpx;
  background: linear-gradient(135deg, rgba(79,70,229,0.1) 0%, rgba(168,85,247,0.1) 100%);
  border-radius: 16rpx;
  border: 2rpx solid rgba(79,70,229,0.15);
}

.motto-text {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #4f46e5;
  text-align: center;
  letter-spacing: 4rpx;
}

/* 动作示意中的口诀 */
.diagram-motto {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #4f46e5;
  margin-top: 14rpx;
  letter-spacing: 3rpx;
}

.flow-step.motto-step {
  background: rgba(79,70,229,0.06);
  border: 1rpx solid rgba(79,70,229,0.12);
}

.flow-badge.motto-badge,
.detailed-step-badge.motto-badge {
  background: linear-gradient(135deg, #6c5ce7 0%, #4f46e5 100%);
  color: #fff;
  font-weight: 600;
}

/* 动作要领区域 */
.instructions-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.instructions-header .subtitle {
  margin-bottom: 0;
}

.check-progress {
  font-size: 24rpx;
  color: #4f46e5;
  font-weight: 600;
}

.motto-highlight {
  margin-bottom: 24rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, rgba(79,70,229,0.08) 0%, rgba(168,85,247,0.06) 100%);
  border-radius: 18rpx;
  text-align: center;
  border: 2rpx solid rgba(79,70,229,0.12);
}

.motto-highlight-text {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #4f46e5;
  letter-spacing: 6rpx;
  line-height: 1.6;
}

/* 要领确认清单 */
.step-check-list {
  margin-bottom: 24rpx;
  padding: 20rpx;
  background: #f8fafc;
  border-radius: 18rpx;
}

.step-check-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #eef2f7;
}

.step-check-item:last-child {
  border-bottom: none;
}

.step-check-box {
  width: 44rpx;
  height: 44rpx;
  border-radius: 10rpx;
  border: 3rpx solid #d0d5dd;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: all 0.2s;
}

.step-check-item.checked .step-check-box {
  background: #4f46e5;
  border-color: #4f46e5;
}

.step-check-icon {
  font-size: 24rpx;
  color: #fff;
  font-weight: 700;
}

.step-check-label {
  flex: 1;
  font-size: 28rpx;
  color: #344054;
  font-weight: 600;
}

.step-check-item.checked .step-check-label {
  color: #4f46e5;
}

.step-check-hint {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #16a34a;
  text-align: center;
  font-weight: 600;
}

/* 口诀式步骤卡片 */
.detailed-step-card {
  display: flex;
  gap: 16rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  background: #f8fafc;
  margin-bottom: 14rpx;
}

.detailed-step-card.motto-card {
  background: rgba(79,70,229,0.04);
  border: 1rpx solid rgba(79,70,229,0.1);
}

.detailed-step-card.warning-card {
  background: rgba(245,158,11,0.06);
  border: 1rpx solid rgba(245,158,11,0.12);
}

.detailed-step-badge {
  min-width: 112rpx;
  font-size: 22rpx;
  color: #4f46e5;
  background: rgba(102,126,234,0.12);
  border-radius: 999rpx;
  text-align: center;
  padding: 10rpx 12rpx;
  align-self: flex-start;
}

.detailed-step-badge.warning-badge {
  color: #b54708;
  background: rgba(245,158,11,0.15);
}

.detailed-step-body {
  flex: 1;
  font-size: 28rpx;
  color: #344054;
  line-height: 1.7;
}

/* 演示模式横幅 */
.demo-banner {
  margin-bottom: 20rpx;
  padding: 20rpx 24rpx;
  background: linear-gradient(135deg, rgba(245,158,11,0.12) 0%, rgba(251,191,36,0.12) 100%);
  border: 2rpx solid rgba(245,158,11,0.2);
  border-radius: 18rpx;
  text-align: center;
}

.demo-banner-text {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #b45309;
  margin-bottom: 6rpx;
}

.demo-banner-hint {
  display: block;
  font-size: 22rpx;
  color: #92400e;
}

/* 休息时口诀提醒 */
.rest-encouragement {
  display: block;
  margin-top: 24rpx;
  padding: 16rpx 28rpx;
  font-size: 26rpx;
  color: rgba(255,255,255,0.9);
  background: rgba(255,255,255,0.12);
  border-radius: 999rpx;
  text-align: center;
  letter-spacing: 2rpx;
}
