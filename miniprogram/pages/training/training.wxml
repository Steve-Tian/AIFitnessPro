<!-- miniprogram/pages/training/training.wxml -->
<view class="container">
  <!-- 顶部导航 -->
  <view class="header">
    <button class="back-btn" bindtap="goBack">← 返回</button>
    <text class="title">训练会话</text>
    <view class="spacer"></view>
  </view>

  <view class="state-card" wx:if="{{isLoading}}">
    <text class="state-title">训练内容加载中</text>
    <text class="state-desc">正在同步本地动作库与云端内容，请稍等片刻</text>
  </view>

  <view class="state-card error" wx:if="{{loadError}}">
    <text class="state-title">{{loadError}}</text>
    <text class="state-desc">可以返回首页重新生成计划，或稍后再试</text>
  </view>

  <view class="training-body" wx:if="{{showTrainingBody}}">
    <view class="support-card" wx:if="{{warmup.length}}">
      <view class="section-head">
        <text class="section-name">训练前热身</text>
        <text class="section-tag">今日针对性</text>
      </view>
      <view class="support-item" wx:for="{{warmup}}" wx:key="name">
        <view class="support-head">
          <text class="support-name">{{item.name}}</text>
          <text class="support-duration">{{item.duration}}</text>
        </view>
        <text class="support-focus" wx:if="{{item.focusText}}">{{item.focusText}}</text>
        <view class="support-step" wx:for="{{item.instructionSteps}}" wx:key="label">
          <text class="support-badge">{{item.label}}</text>
          <text class="support-text">{{item.text}}</text>
        </view>
      </view>
    </view>

    <!-- 动作信息 -->
    <view class="exercise-info">
      <text class="exercise-name">{{exercise.name}}</text>
      <text class="exercise-alias" wx:if="{{exercise.alias}}">别名：{{exercise.alias}}</text>
      <text class="exercise-summary">{{exercise.summary}}</text>
      <view class="adaptive-banner" wx:if="{{exercise.hasAdaptiveNote}}">
        <text class="adaptive-title">自动调节建议</text>
        <text class="adaptive-text">{{exercise.adaptiveNote}}</text>
      </view>
      <view class="set-progress">
        <text class="set-text">第 {{currentSet}}/{{totalSets}} 组</text>
        <progress percent="{{progressPercent}}" activeColor="#667eea" />
      </view>
    </view>

    <view class="support-card adaptive-notes" wx:if="{{adaptiveNotes.length}}">
      <view class="section-head">
        <text class="section-name">本日自动调节</text>
        <text class="section-tag">根据上次反馈</text>
      </view>
      <view class="adaptive-note" wx:for="{{adaptiveNotes}}" wx:key="exerciseName">
        <text class="adaptive-note-name">{{item.exerciseName}}</text>
        <text class="adaptive-note-text">{{item.note}}</text>
      </view>
    </view>

    <view class="timer-area" wx:if="{{isCountingDown}}">
      <text class="timer-text">准备！</text>
      <text class="timer-number">{{countdown}}</text>
      <text class="timer-label">{{prepStatusLabel}}</text>
      <button class="timer-skip-btn" bindtap="skipCurrentSet">{{setSkipButtonLabel}}</button>
      <button class="timer-skip-btn timer-skip-exercise-btn" bindtap="skipCurrentExercise">跳过当前动作</button>
    </view>

    <view class="timer-area" wx:if="{{showRestTimer}}">
      <text class="timer-text">休息时间</text>
      <text class="timer-number">{{countdown}}</text>
      <text class="timer-label">距离下一组</text>
      <view class="timer-skip-row">
        <button class="timer-quick-btn" data-seconds="15" bindtap="shortenRestPeriod">-15 秒</button>
        <button class="timer-quick-btn" data-seconds="30" bindtap="shortenRestPeriod">-30 秒</button>
      </view>
      <button class="timer-skip-btn" bindtap="skipRestPeriod">{{restSkipButtonLabel}}</button>
      <button class="timer-skip-btn timer-skip-exercise-btn" bindtap="skipCurrentExercise">跳过当前动作</button>
    </view>

    <view class="media-area" wx:if="{{showMediaArea}}">
      <view class="visual-card">
        <view class="section-head">
          <text class="section-name">动作示意</text>
          <view class="section-actions">
            <text class="section-tag" wx:if="{{exercise.categoryLabel}}">{{exercise.categoryLabel}}</text>
            <text class="detail-jump" bindtap="openExerciseDetail">动作详情</text>
          </view>
        </view>

        <image 
          wx:if="{{exercise.hasMedia}}"
          src="{{exercise.mediaUrl}}" 
          class="exercise-gif" 
          mode="aspectFit"
          lazy-load="true"
          binderror="handleMediaError"
        />

        <view class="motion-diagram" wx:else>
          <view class="diagram-hero">
            <text class="diagram-title">{{exercise.name}}</text>
            <text class="diagram-subtitle">{{exercise.targetSummary}}</text>
          </view>

          <view class="diagram-columns">
            <view class="diagram-column">
              <text class="diagram-column-title">主练肌群</text>
              <view class="tag-row">
                <text class="muscle-chip primary" wx:for="{{exercise.primaryMuscles}}" wx:key="index">{{item}}</text>
              </view>
            </view>

            <view class="diagram-column">
              <text class="diagram-column-title">辅助肌群</text>
              <view class="tag-row" wx:if="{{exercise.hasSecondaryMuscles}}">
                <text class="muscle-chip secondary" wx:for="{{exercise.secondaryMuscles}}" wx:key="index">{{item}}</text>
              </view>
              <text class="fallback-note" wx:if="{{!exercise.hasSecondaryMuscles}}">核心稳定 / 关节控制</text>
            </view>
          </view>

          <view class="diagram-flow">
            <view class="flow-step" wx:for="{{exercise.instructionSteps}}" wx:key="label">
              <text class="flow-badge">{{item.label}}</text>
              <text class="flow-text">{{item.text}}</text>
            </view>
          </view>
        </view>
      </view>

      <view class="muscle-card">
        <text class="subtitle">发力肌群</text>
        <view class="muscle-group">
          <text class="muscle-group-label">主练</text>
          <view class="tag-row">
            <text class="muscle-chip primary" wx:for="{{exercise.primaryMuscles}}" wx:key="index">{{item}}</text>
          </view>
        </view>
        <view class="muscle-group">
          <text class="muscle-group-label">辅助</text>
          <text class="muscle-summary">{{exercise.secondaryMusclesText}}</text>
        </view>
        <view class="fact-grid">
          <view class="fact-card">
            <text class="fact-label">器械</text>
            <text class="fact-value">{{exercise.equipmentText}}</text>
          </view>
          <view class="fact-card">
            <text class="fact-label">难度</text>
            <text class="fact-value">{{exercise.difficultyLabel}}</text>
          </view>
        </view>
      </view>

      <view class="instructions">
        <text class="subtitle">动作要领</text>
        <view class="instruction-card" wx:for="{{exercise.instructionSteps}}" wx:key="label">
          <text class="instruction-badge">{{item.label}}</text>
          <text class="instruction-body">{{item.text}}</text>
        </view>
        <view class="tips" wx:if="{{exercise.hasTips}}">
          <text class="tips-title">训练提示</text>
          <view class="tip-card" wx:for="{{exercise.tips}}" wx:key="index">
            <text class="tip">{{item}}</text>
          </view>
        </view>
        <view class="mistakes" wx:if="{{exercise.hasCommonMistakes}}">
          <text class="tips-title">常见错误</text>
          <view class="mistake-card" wx:for="{{exercise.commonMistakes}}" wx:key="index">
            <text class="tip">{{item}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 底部操作区 -->
    <view class="controls">
      <button class="control-btn skip-btn" bindtap="skipCurrentExercise">{{skipButtonLabel}}</button>
      
      <button
        class="control-btn start-btn"
        bindtap="startExercise"
        wx:if="{{showMediaArea}}"
      >
        {{actionButtonLabel}}
      </button>
      
      <button class="control-btn disabled-btn" wx:if="{{!showMediaArea}}" disabled>
        {{disabledButtonLabel}}
      </button>
    </view>

    <view class="support-card" wx:if="{{cooldown.length}}">
      <view class="section-head">
        <text class="section-name">练后拉伸</text>
        <text class="section-tag">训练结束后完成</text>
      </view>
      <view class="support-item" wx:for="{{cooldown}}" wx:key="name">
        <view class="support-head">
          <text class="support-name">{{item.name}}</text>
          <text class="support-duration">{{item.duration}}</text>
        </view>
        <view class="support-step" wx:for="{{item.instructionSteps}}" wx:key="label">
          <text class="support-badge">{{item.label}}</text>
          <text class="support-text">{{item.text}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="rpe-modal" wx:if="{{showExerciseFeedbackSelector}}">
    <view class="modal-overlay"></view>
    <view class="modal-content">
      <text class="modal-title">{{exerciseFeedbackTarget.exerciseName}} 完成情况</text>
      <text class="modal-desc">这个动作感觉如何？我们会据此自动调整后续重量、组数或次数。</text>
      
      <view class="rpe-grid">
        <button 
          class="{{item.className}}" 
          wx:for="{{exerciseFeedbackOptions}}" 
          wx:key="value"
          data-rpe="{{item.value}}"
          bindtap="selectExerciseRPE"
        >
          {{item.value}}
        </button>
      </view>
      
      <text class="rpe-legend">
        6=很轻松  7=较轻松  8=刚好  9=很累  10=极限
      </text>
      
      <button class="confirm-btn" bindtap="confirmExerciseFeedback">确认并继续</button>
    </view>
  </view>

  <view class="rpe-modal" wx:if="{{showRPESelector}}">
    <view class="modal-overlay" bindtap="hideRPESelector"></view>
    <view class="modal-content">
      <text class="modal-title">本次训练感觉如何？</text>
      <text class="modal-desc">请选择 RPE 评分（6-10分）</text>
      
      <view class="rpe-grid">
        <button 
          class="{{item.className}}" 
          wx:for="{{rpeOptions}}" 
          wx:key="value"
          data-rpe="{{item.value}}"
          bindtap="selectRPE"
        >
          {{item.value}}
        </button>
      </view>
      
      <text class="rpe-legend">
        6=很轻松  7=较轻松  8=刚好  9=很累  10=极限
      </text>
      
      <button class="confirm-btn" bindtap="submitFeedback">提交反馈</button>
    </view>
  </view>
</view>
