<view class="page" wx:if="{{exercise}}">
  <scroll-view class="scroll" scroll-y>
    <view class="hero-card">
      <video
        wx:if="{{exercise.hasVideo}}"
        class="hero-image"
        src="{{exercise.videoUrl}}"
        poster="{{exercise.coverUrl}}"
        controls
        object-fit="cover"
      />
      <image wx:else class="hero-image" src="{{exercise.hasGif ? exercise.mediaUrl : exercise.coverUrl}}" mode="aspectFill" bindtap="previewMedia" />
      <view class="hero-overlay">
        <text class="hero-name">{{exercise.name_cn}}</text>
        <text class="hero-en">{{exercise.name_en}}</text>
        <view class="hero-tags">
          <text class="hero-pill">{{exercise.categoryLabel}}</text>
          <text class="hero-pill">{{exercise.difficultyLabel}}</text>
          <text class="hero-pill">{{exercise.hasVideo ? '视频示范' : (exercise.hasGif ? 'GIF 示范' : '封面待升级')}}</text>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-head">
        <text class="section-title">动作示范</text>
        <text class="section-status">{{exercise.mediaStatus}}</text>
      </view>
      <view class="media-card">
        <video
          wx:if="{{exercise.hasVideo}}"
          class="media-video"
          src="{{exercise.videoUrl}}"
          poster="{{exercise.coverUrl}}"
          controls
          object-fit="contain"
        />
        <image wx:else class="media-image" src="{{exercise.hasGif ? exercise.mediaUrl : exercise.coverUrl}}" mode="aspectFit" bindtap="previewMedia" />
        <text class="media-note">{{exercise.hasVideo ? '先直接看视频动作轨迹，再开始练。' : (exercise.hasGif ? '优先照着 GIF 轨迹练，不必先读长步骤。' : '当前还是静态封面。等云端同步 GIF 或视频后，这里会自动升级。')}}</text>
      </view>
    </view>

    <view class="section">
      <text class="section-title">内容状态</text>
      <view class="fact-grid">
        <view class="fact-card">
          <text class="fact-label">当前来源</text>
          <text class="fact-value">{{sourceLabel}}</text>
        </view>
        <view class="fact-card">
          <text class="fact-label">同步状态</text>
          <text class="fact-value">{{isRefreshing ? '正在尝试从云端刷新内容' : '当前内容已就绪'}}</text>
        </view>
      </view>
    </view>

    <view class="section">
      <text class="section-title">发力肌群</text>
      <view class="info-card">
        <text class="info-label">主练</text>
        <view class="tag-row">
          <text class="tag primary" wx:for="{{exercise.primaryMuscles}}" wx:key="index">{{item}}</text>
        </view>
        <text class="info-label">辅助</text>
        <text class="info-body">{{exercise.secondaryText}}</text>
      </view>
    </view>

    <view class="section" wx:if="{{exercise.overviewText}}">
      <text class="section-title">动作概述</text>
      <view class="info-card">
        <text class="info-body">{{exercise.overviewText}}</text>
      </view>
    </view>

    <view class="section">
      <text class="section-title">动作速记</text>
      <view class="bullet-card" wx:for="{{exercise.instructions}}" wx:key="index">
        <text class="bullet-text">{{item}}</text>
      </view>
    </view>

    <view class="section" wx:if="{{exercise.exercise_tips && exercise.exercise_tips.length}}">
      <text class="section-title">训练提示</text>
      <view class="bullet-card" wx:for="{{exercise.exercise_tips}}" wx:key="index">
        <text class="bullet-text">{{item}}</text>
      </view>
    </view>

    <view class="section" wx:if="{{exercise.common_mistakes && exercise.common_mistakes.length}}">
      <text class="section-title">常见错误</text>
      <view class="bullet-card warning" wx:for="{{exercise.common_mistakes}}" wx:key="index">
        <text class="bullet-text">{{item}}</text>
      </view>
    </view>

    <view class="section">
      <text class="section-title">内容包字段</text>
      <view class="fact-grid">
        <view class="fact-card">
          <text class="fact-label">动作 ID</text>
          <text class="fact-value">{{exercise.exercise_id}}</text>
        </view>
        <view class="fact-card">
          <text class="fact-label">器械</text>
          <text class="fact-value">{{exercise.equipmentText}}</text>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
