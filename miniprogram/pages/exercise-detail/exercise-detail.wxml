<view class="page" wx:if="{{exercise}}">
  <scroll-view class="scroll" scroll-y>
    <view class="hero-card">
      <image class="hero-image" src="{{exercise.coverUrl}}" mode="aspectFill" bindtap="previewMedia" />
      <view class="hero-overlay">
        <text class="hero-name">{{exercise.name_cn}}</text>
        <text class="hero-en">{{exercise.name_en}}</text>
        <view class="hero-tags">
          <text class="hero-pill">{{exercise.categoryLabel}}</text>
          <text class="hero-pill">{{exercise.difficultyLabel}}</text>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-head">
        <text class="section-title">媒体资源</text>
        <text class="section-status">{{exercise.mediaStatus}}</text>
      </view>
      <view class="media-card">
        <image class="media-image" src="{{exercise.hasGif ? exercise.mediaUrl : exercise.coverUrl}}" mode="aspectFit" bindtap="previewMedia" />
        <text class="media-note">{{exercise.hasGif ? '已同步动图，可点按放大查看' : '当前展示静态封面。后续同步 GIF / MP4 / WebM 后，这里会自动替换。'}}</text>
      </view>
    </view>

    <view class="section">
      <text class="section-title">发力肌群</text>
      <view class="info-card">
        <text class="info-label">主练</text>
        <view class="tag-row">
          <text class="tag primary" wx:for="{{exercise.primaryMuscles}}" wx:key="index">{{item}}</text>
        </view>
        <text class="info-label">辅助</text>
        <text class="info-body">{{exercise.secondaryText}}</text>
      </view>
    </view>

    <view class="section">
      <text class="section-title">动作要领</text>
      <view class="step-card" wx:for="{{exercise.instructionSteps}}" wx:key="label">
        <text class="step-index">{{item.label}}</text>
        <text class="step-text">{{item.text}}</text>
      </view>
    </view>

    <view class="section" wx:if="{{exercise.exercise_tips && exercise.exercise_tips.length}}">
      <text class="section-title">训练提示</text>
      <view class="bullet-card" wx:for="{{exercise.exercise_tips}}" wx:key="index">
        <text class="bullet-text">{{item}}</text>
      </view>
    </view>

    <view class="section" wx:if="{{exercise.common_mistakes && exercise.common_mistakes.length}}">
      <text class="section-title">常见错误</text>
      <view class="bullet-card warning" wx:for="{{exercise.common_mistakes}}" wx:key="index">
        <text class="bullet-text">{{item}}</text>
      </view>
    </view>

    <view class="section">
      <text class="section-title">内容包字段</text>
      <view class="fact-grid">
        <view class="fact-card">
          <text class="fact-label">动作 ID</text>
          <text class="fact-value">{{exercise.exercise_id}}</text>
        </view>
        <view class="fact-card">
          <text class="fact-label">器械</text>
          <text class="fact-value">{{exercise.equipmentText}}</text>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
