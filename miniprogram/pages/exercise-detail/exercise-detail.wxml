<view class="page">
  <view class="state-card" wx:if="{{isLoading && !exercise}}">
    <text class="state-title">动作详情加载中</text>
    <text class="state-desc">正在同步 GIF / 视频与动作说明</text>
  </view>

  <view class="state-card error" wx:if="{{!isLoading && loadError && !exercise}}">
    <text class="state-title">{{loadError}}</text>
    <text class="state-desc">如果刚同步了新动作，稍后再试一次会更稳</text>
  </view>

  <view class="page-content" wx:if="{{exercise}}">
    <scroll-view class="scroll" scroll-y>
      <view class="hero-card">
        <block wx:if="{{exercise.hasVideo}}">
          <video
            class="hero-image"
            src="{{exercise.videoUrl}}"
            poster="{{exercise.coverUrl}}"
            controls
            object-fit="cover"
          ></video>
        </block>
        <block wx:elif="{{exercise.hasGif}}">
          <image
            class="hero-image"
            src="{{exercise.mediaUrl}}"
            mode="aspectFill"
            bindtap="previewMedia"
          ></image>
        </block>
        <block wx:else>
          <view class="hero-placeholder">
            <text class="hero-placeholder-name">{{exercise.name_cn}}</text>
            <text class="hero-placeholder-hint">动图同步中，请先参考下方口诀和步骤</text>
          </view>
        </block>

        <view class="hero-overlay">
          <view class="hero-topline">
            <text class="hero-chip">{{sourceLabel}}</text>
            <text class="hero-chip">{{exercise.mediaLabel}}</text>
          </view>

          <text class="hero-name">{{exercise.name_cn}}</text>
          <text class="hero-en">{{exercise.name_en}}</text>

          <view class="hero-motto" wx:if="{{exercise.motto}}">
            <text class="hero-motto-text">{{exercise.motto}}</text>
          </view>

          <view class="hero-tags">
            <text class="hero-pill">{{exercise.categoryLabel}}</text>
            <text class="hero-pill">{{exercise.difficultyLabel}}</text>
            <text class="hero-pill">{{exercise.equipmentText}}</text>
          </view>

          <view class="hero-highlight-list" wx:if="{{exercise.heroHighlights && exercise.heroHighlights.length}}">
            <view class="hero-highlight" wx:for="{{exercise.heroHighlights}}" wx:key="index">
              <text class="hero-highlight-text">{{item}}</text>
            </view>
          </view>
        </view>
      </view>

      <view class="section" wx:if="{{exercise.motto}}">
        <view class="motto-card">
          <text class="motto-card-label">动作口诀</text>
          <text class="motto-card-text">{{exercise.motto}}</text>
          <text class="motto-card-hint">记住口诀，训练时心中默念</text>
        </view>
      </view>

      <view class="section">
        <view class="section-head">
          <text class="section-title">动作示范</text>
          <text class="section-status">{{exercise.mediaStatus}}</text>
        </view>
        <view class="media-card">
          <view class="media-layout">
            <view class="media-panel">
              <block wx:if="{{exercise.hasVideo}}">
                <video
                  class="media-video"
                  src="{{exercise.videoUrl}}"
                  poster="{{exercise.coverUrl}}"
                  controls
                  object-fit="contain"
                ></video>
              </block>
              <block wx:elif="{{exercise.hasGif}}">
                <image
                  class="media-image"
                  src="{{exercise.mediaUrl}}"
                  mode="aspectFit"
                  bindtap="previewMedia"
                ></image>
              </block>
              <block wx:else>
                <view class="media-placeholder">
                  <text class="media-placeholder-title">{{exercise.motto || exercise.name_cn}}</text>
                  <text class="media-placeholder-desc">动图正在同步中，请参考下方详细步骤</text>
                </view>
              </block>
            </view>

            <view class="media-note">
              <text class="media-note-text">{{exercise.mediaNoteText}}</text>
            </view>

            <view class="muscle-panel">
              <text class="panel-title">训练部位</text>
              <image wx:if="{{exercise.muscleMapUrl}}" class="muscle-map" src="{{exercise.muscleMapUrl}}" mode="aspectFit" />
              <view class="tag-row">
                <text class="tag primary" wx:for="{{exercise.primaryMuscles}}" wx:key="index">{{item}}</text>
              </view>

              <view class="muscle-note">
                <text class="muscle-note-label">辅助发力</text>
                <text class="muscle-note-text">{{exercise.secondaryText}}</text>
              </view>

              <view class="muscle-note" wx:if="{{exercise.overviewText}}">
                <text class="muscle-note-label">动作重点</text>
                <text class="muscle-note-text">{{exercise.overviewText}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <view class="section">
        <text class="section-title">详细步骤</text>
        <view class="step-card {{item.isMotto ? 'step-motto' : ''}} {{item.label === '避免' ? 'step-warning' : ''}}" wx:for="{{exercise.detailedStepCards}}" wx:key="index">
          <text class="step-badge {{item.isMotto ? 'badge-motto' : ''}} {{item.label === '避免' ? 'badge-warning' : ''}}">{{item.label}}</text>
          <text class="step-text">{{item.text}}</text>
        </view>
      </view>

      <view class="section" wx:if="{{exercise.common_mistakes && exercise.common_mistakes.length}}">
        <text class="section-title">重点提醒</text>
        <view class="warning-grid">
          <view class="warning-chip" wx:for="{{exercise.common_mistakes}}" wx:key="index">
            <text class="warning-text">避免 {{item}}</text>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>
</view>
