/* miniprogram/pages/index/index.wxss */
.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.user-card {
  background: linear-gradient(135deg, #667eea, #764ba2);
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
  color: white;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
}

.username {
  font-size: 36rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 20rpx;
}

.streak {
  display: flex;
  align-items: center;
}

.streak-num {
  font-size: 60rpx;
  font-weight: bold;
  margin-right: 15rpx;
}

.streak-label {
  font-size: 24rpx;
  opacity: 0.9;
}

.plan-section {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.generate-btn {
  background: #667eea;
  color: white;
  border: none;
  border-radius: 50rpx;
  padding: 15rpx 30rpx;
  font-size: 28rpx;
}

.generate-btn[disabled] {
  background: #ccc;
}

.regenerate-btn {
  background: transparent;
  color: #667eea;
  border: 2rpx solid #667eea;
  font-size: 24rpx;
}

.regenerate-btn[disabled] {
  color: #ccc;
  border-color: #ccc;
  background: transparent;
}

.plan-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(300rpx, 1fr));
  gap: 20rpx;
}

.day-card {
  border: 2rpx solid #e0e0e0;
  border-radius: 15rpx;
  padding: 25rpx;
  position: relative;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.day-card.clickable {
  box-shadow: 0 8rpx 20rpx rgba(102, 126, 234, 0.08);
}

.day-card.clickable:active {
  transform: scale(0.98);
}

.day-card.push {
  border-left: 8rpx solid #ff6b6b;
}

.day-card.pull {
  border-left: 8rpx solid #4ecdc4;
}

.day-card.legs {
  border-left: 8rpx solid #45b7d1;
}

.day-card.rest-day {
  border-left: 8rpx solid #95a5a6;
  background-color: #f8f9fa;
}

.day-date {
  font-size: 24rpx;
  color: #666;
  display: block;
  margin-bottom: 10rpx;
}

.day-type {
  font-size: 32rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 20rpx;
}

.workout-list {
  margin-top: 15rpx;
}

.exercise-item {
  padding: 15rpx 0;
  border-bottom: 1rpx solid #eee;
}

.exercise-item:last-child {
  border-bottom: none;
}

.exercise-name {
  font-size: 28rpx;
  font-weight: 500;
  display: block;
  margin-bottom: 8rpx;
}

.exercise-meta {
  font-size: 24rpx;
  color: #888;
}

.tap-hint {
  display: block;
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #667eea;
}

.rest-note {
  font-style: italic;
  color: #666;
  text-align: center;
  padding: 40rpx 0;
}

.empty-state {
  text-align: center;
  padding: 80rpx 0;
  color: #999;
}

.empty-state text {
  display: block;
  margin-bottom: 20rpx;
}

/* 练习详情 */
.exercise-details {
  margin-top: 10rpx;
  padding: 15rpx;
  background-color: #f8f9fa;
  border-radius: 10rpx;
  border-left: 6rpx solid #667eea;
}

.exercise-detail-title {
  font-size: 24rpx;
  color: #555;
  font-weight: bold;
  display: block;
  margin-bottom: 8rpx;
}

.exercise-instruction {
  font-size: 24rpx;
  color: #666;
  display: block;
  margin-bottom: 6rpx;
  line-height: 1.4;
}

.shortcut-section {
  display: flex;
  gap: 20rpx;
  margin-top: 30rpx;
  margin-bottom: 10rpx;
}

.shortcut-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: white;
  border-radius: 16rpx;
  padding: 24rpx 0;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}

.shortcut-icon {
  font-size: 36rpx;
}

.shortcut-label {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.dev-reset-section {
  margin-top: 60rpx;
  padding: 0 30rpx 80rpx;
}

.dev-reset-btn {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  color: #e53e3e;
  background: #fff;
  border: 2rpx solid #fed7d7;
  border-radius: 16rpx;
}
