<!-- miniprogram/pages/index/index.wxml -->
<view class="container">
  <!-- 用户信息区 -->
  <view class="user-card" wx:if="{{userInfo}}">
    <text class="username">欢迎回来，{{userInfo.profile.persona === 'beauty_coach' ? '美女教练' : userInfo.profile.persona || '健身伙伴'}}！</text>
    <view class="streak">
      <text class="streak-num">{{streakDays}}</text>
      <text class="streak-label">连续打卡天数</text>
    </view>
  </view>

  <!-- 计划生成/展示区 -->
  <view class="plan-section">
    <view class="section-header">
      <text class="section-title">本周训练计划</text>
      <button 
        class="generate-btn" 
        bindtap="generatePlan" 
        disabled="{{generatingPlan}}"
        wx:if="{{!weeklyPlan}}"
      >
        {{generatingPlan ? '生成中...' : '生成本周计划'}}
      </button>
    </view>

    <!-- 计划详情 -->
    <view class="plan-grid" wx:if="{{weeklyPlan}}">
      <view 
        class="day-card {{day.type === 'rest' ? 'rest-day' : day.type}}" 
        wx:for="{{weeklyPlan}}" 
        wx:key="date"
      >
        <text class="day-date">{{day.date}}</text>
        <text class="day-type">{{day.title}}</text>
        <view class="workout-list" wx:if="{{day.workout && day.workout.length > 0}}">
          <view class="exercise-item" wx:for="{{day.workout}}" wx:key="name">
            <text class="exercise-name">{{item.name}}</text>
            <text class="exercise-meta">{{item.sets}}组 × {{item.reps}}次 | 休息{{item.rest}}秒</text>
          </view>
        </view>
        <text class="rest-note" wx:else>{{day.note}}</text>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:else>
      <text>还没有训练计划</text>
      <text>点击上方按钮生成专属计划</text>
    </view>
  </view>
</view>