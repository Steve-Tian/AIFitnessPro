<!-- miniprogram/pages/index/index.wxml -->
<view class="container">
  <!-- 用户信息区 -->
  <view class="user-card" wx:if="{{userInfo}}">
    <text class="username">欢迎回来，{{welcomeLabel}}！</text>
    <view class="streak">
      <text class="streak-num">{{streakDays}}</text>
      <text class="streak-label">连续打卡天数</text>
    </view>
  </view>

  <!-- 计划生成/展示区 -->
  <view class="plan-section">
    <view class="section-header">
      <text class="section-title">本周训练计划</text>
      <button 
        class="generate-btn" 
        bindtap="generatePlan" 
        disabled="{{generatingPlan}}"
        wx:if="{{!weeklyPlan}}"
      >
        {{generatingPlan ? '生成中...' : '生成本周计划'}}
      </button>
      <button 
        class="generate-btn regenerate-btn" 
        bindtap="generatePlan" 
        disabled="{{generatingPlan}}"
        wx:if="{{weeklyPlan}}"
      >
        {{generatingPlan ? '生成中...' : '重新生成计划'}}
      </button>
    </view>

    <!-- 计划详情 -->
    <view class="plan-grid" wx:if="{{weeklyPlan && weeklyPlan.length}}">
      <view 
        class="day-card {{item.type === 'rest' ? 'rest-day' : item.type}} {{item.workout && item.workout.length ? 'clickable' : ''}}" 
        wx:for="{{weeklyPlan}}" 
        wx:key="date"
        wx:for-item="item"
        bindtap="openPlanDay"
        data-index="{{index}}"
      >
        <text class="day-date">{{item.date}}</text>
        <text class="day-type">{{item.title}}</text>
        <view class="workout-list" wx:if="{{item.workout && item.workout.length > 0}}">
          <view class="exercise-item" wx:for="{{item.workout}}" wx:key="name" wx:for-item="exercise">
            <text class="exercise-name">{{exercise.name}}</text>
            <text class="exercise-meta">{{exercise.sets}}组 × {{exercise.reps}}次 | 休息{{exercise.rest}}秒</text>
            <view class="exercise-details" wx:if="{{exercise.instructions && exercise.instructions.length > 0}}">
              <text class="exercise-detail-title">动作要领:</text>
              <text class="exercise-instruction" wx:for="{{exercise.instructions}}" wx:key="index">• {{item}}</text>
            </view>
          </view>
          <text class="tap-hint">点击开始本日训练</text>
        </view>
        <text class="rest-note" wx:else>{{item.note}}</text>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:else>
      <text>还没有训练计划</text>
      <text>点击上方按钮生成专属计划</text>
    </view>
  </view>
</view>
