.container {
  padding: 30rpx;
  min-height: 100vh;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 50rpx;
  text-align: center;
}

button {
  background: #667eea;
  color: white;
  border: none;
  border-radius: 10rpx;
  padding: 20rpx;
  font-size: 32rpx;
  margin-bottom: 50rpx;
  width: 100%;
}

.result {
  margin-top: 30rpx;
}

.result-title {
  font-size: 32rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 20rpx;
}

.result-content {
  font-size: 24rpx;
  color: #666;
  line-height: 1.6;
  background: #f5f5f5;
  padding: 20rpx;
  border-radius: 10rpx;
  white-space: pre-wrap;
}