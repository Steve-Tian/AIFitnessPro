<view class="container">
  <text class="title">云函数测试页面</text>
  
  <button bindtap="testGenPlan" disabled="{{isTesting}}">
    {{isTesting ? '测试中...' : '测试 genPlan 云函数'}}
  </button>
  
  <view wx:if="{{testResult}}" class="result">
    <text class="result-title">测试结果:</text>
    <text class="result-content">{{testResult}}</text>
  </view>
</view>