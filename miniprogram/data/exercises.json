      "alias": ["侧平举"],
      "category": "push",
      "muscle": ["shoulders"],
      "equipment": ["dumbbell_only"],
      "difficulty": "beginner",
      "gifUrl": "https://example.com/gifs/lateral_raise.gif",
      "instructions": [
        "站立，双手持哑铃垂于身体两侧",
        "向两侧抬起至与肩同高",
        "缓慢下放至起始位置"
      ],
      "tips": [
        "轻微前倾身体以更好孤立三角肌",
        "控制动作节奏"
      ],
      "commonMistakes": [
        "借力摆动身体",
        "抬得过高造成耸肩"
      ]
    },
    {
