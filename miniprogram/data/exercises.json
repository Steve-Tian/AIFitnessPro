        "挺胸收腹，推起至头顶上方",
        "缓慢下放至起始位置"
      ],
      "tips": [
        "核心绷紧，避免过度后倾",
        "呼吸配合：推起时呼气"
      ],
      "commonMistakes": [
        "腰部过度反弓",
        "颈部压迫杠铃"
      ]
    },
    {
