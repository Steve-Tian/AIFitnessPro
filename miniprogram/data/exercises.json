{
  "exercises": [
    {
      "id": "bench_press",
      "name": "杠铃卧推",
      "alias": ["卧推"],
      "category": "push",
      "muscle": ["chest", "triceps", "front_delts"],
      "equipment": ["full_gym", "barbell_bench"],
      "difficulty": "intermediate",
      "gifUrl": "https://example.com/gifs/bench_press.gif",
      "instructions": [
        "仰卧在平板凳上，双脚平放地面",
        "双手握杠铃，略宽于肩",
        "缓慢下放至胸部附近，停留1秒",
        "推起至手臂伸直但不过锁"
      ],
      "tips": [
        "保持肩胛骨收紧",
        "手腕中立位，避免过度弯曲"
      ],
      "commonMistakes": [
        "拱腰过大",
        "肘角过窄伤肩"
      ]
    },
    {
      "id": "dumbbell_fly",
      "name": "哑铃飞鸟",
      "alias": ["飞鸟"],
      "category": "push",
      "muscle": ["chest"],
      "equipment": ["dumbbell_only"],
      "difficulty": "beginner",
      "gifUrl": "https://example.com/gifs/dumbbell_fly.gif",
      "instructions": [
        "仰卧平板，双手持哑铃举过胸前",
        "手肘微屈，向两侧打开至胸部有拉伸感",
        "沿弧线回到起始位置"
      ],
      "tips": [
        "手肘角度固定不变",
        "控制下降速度"
      ],
      "commonMistakes": [
        "手肘过度弯曲",
        "动作幅度过大"
      ]
    },
